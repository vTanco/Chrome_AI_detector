{
  "manifest_version": 3,
  "name": "DocenteLens - Detector de IA en Vivo",
  "short_name": "DocenteLens",
  "version": "1.0.0",
  "description": "Herramienta gratuita para docentes: ilumina en tiempo real texto e imágenes generadas con IA al pulsar Comando ⌘.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "cookies",
    "clipboardRead"
  ],
  "host_permissions": [
    "*://docs.google.com/*",
    "*://*.googleusercontent.com/*",
    "*://classroom.google.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DocenteLens - Panel del Docente",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "match_about_blank": true,
      "js": [
        "lib/heuristics-es.js",
        "lib/heuristics-en.js",
        "lib/ai-model-profiler.js",
        "lib/ai-text-detector.js",
        "lib/ai-image-detector.js",
        "lib/report-generator.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://docs.google.com/*"],
      "world": "MAIN",
      "run_at": "document_start",
      "js": ["content/gdocs-canvas-bridge.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/gdocs-canvas-bridge.js"],
      "matches": ["*://docs.google.com/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
