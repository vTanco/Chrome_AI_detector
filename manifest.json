{
  "manifest_version": 3,
  "name": "DocenteLens - Detector de IA en Vivo",
  "short_name": "DocenteLens",
  "version": "1.0.0",
  "description": "Herramienta gratuita para docentes: resalta en tiempo real texto e imágenes generadas con IA al mantener pulsado el ratón.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DocenteLens - Panel del Docente",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/heuristics-es.js",
        "lib/heuristics-en.js",
        "lib/ai-text-detector.js",
        "lib/ai-image-detector.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
